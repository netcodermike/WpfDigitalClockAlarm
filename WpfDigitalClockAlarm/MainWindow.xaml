<Window x:Class="WpfDigitalClockAlarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDigitalClockAlarm"
        xmlns:vm="clr-namespace:WpfDigitalClockAlarm.ViewModels"
        xmlns:conv="clr-namespace:WpfDigitalClockAlarm.Converters"
        mc:Ignorable="d"
        Title="Precision Digital Clock, Alarm &amp; Task Planner"
        Height="780" Width="980"
        MinHeight="700" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI, -apple-system, Roboto, sans-serif">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:TwoDigitConverter x:Key="TwoDigitConv" />
        <conv:SoundTypeDescriptionConverter x:Key="SoundDescConv" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVisConv" />
        <conv:PriorityToColorConverter x:Key="PriorityColorConv" />
        <conv:BoolToTextDecorationConverter x:Key="StrikeConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConv" />

        <!-- Glow DropShadow Effects -->
        <DropShadowEffect x:Key="NeonCyanGlow" Color="#00F0FF" BlurRadius="25" ShadowDepth="0" Opacity="0.75" />
        <DropShadowEffect x:Key="AlarmPulseGlow" Color="#EF4444" BlurRadius="30" ShadowDepth="0" Opacity="0.9" />
        <DropShadowEffect x:Key="ReminderGlow" Color="#F59E0B" BlurRadius="20" ShadowDepth="0" Opacity="0.75" />
        <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45" />

        <!-- Modern Rounded Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preset Button Style -->
        <Style x:Key="PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="BorderBrush" Value="#0284C7" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Primary Action Button (Green / Armed) -->
        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlarmArmed}" Value="False">
                    <Setter Property="Background" Value="#10B981" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAlarmArmed}" Value="True">
                    <Setter Property="Background" Value="#EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Dark ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="34" />
        </Style>

        <!-- Modern Dark ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#00F0FF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          Margin="0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#00F0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark DatePicker -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Top Brand & Mode Bar -->
            <RowDefinition Height="Auto" />
            <!-- Dynamic Digital Clock Banner -->
            <RowDefinition Height="Auto" />
            <!-- Daily Reminder Notification Alert (collapsible) -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Tabs (Alarm vs Tasks) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 0. TOP BRAND & MODE BAR ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="20" Foreground="#00F0FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="PRECISION DIGITAL CHRONO &amp; TASK PLANNER" FontSize="15" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Format:" Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Command="{Binding ToggleTimeFormatCommand}"
                        Style="{StaticResource ModernButtonStyle}"
                        Padding="12,4" Height="30">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Clock: " Foreground="#94A3B8"/>
                        <TextBlock FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="12-Hour (AM/PM)" />
                                    <Setter Property="Foreground" Value="#00F0FF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Is24HourMode}" Value="True">
                                            <Setter Property="Text" Value="24-Hour" />
                                            <Setter Property="Foreground" Value="#38BDF8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 1. DYNAMIC DIGITAL CLOCK DISPLAY CARD ================= -->
        <Border Grid.Row="1"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20,14"
                Margin="0,0,0,12"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Clock Digits Display -->
                <Viewbox Grid.Row="0" MaxHeight="100" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Hour -->
                        <TextBlock Text="{Binding Hours}"
                                   FontFamily="Consolas, 'Courier New', monospace"
                                   FontSize="80"
                                   FontWeight="Bold"
                                   Foreground="#00F0FF"
                                   Effect="{StaticResource NeonCyanGlow}"
                                   VerticalAlignment="Center"/>

                        <!-- Colon 1 (blinking) -->
                        <TextBlock Text=":"
                                   FontFamily="Consolas, 'Courier New', monospace"
                                   FontSize="76"
                                   FontWeight="Bold"
                                   Foreground="#00F0FF"
                                   Margin="2,-6,2,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="1.0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ColonVisible}" Value="False">
                                            <Setter Property="Opacity" Value="0.2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Minute -->
                        <TextBlock Text="{Binding Minutes}"
                                   FontFamily="Consolas, 'Courier New', monospace"
                                   FontSize="80"
                                   FontWeight="Bold"
                                   Foreground="#00F0FF"
                                   Effect="{StaticResource NeonCyanGlow}"
                                   VerticalAlignment="Center"/>

                        <!-- Colon 2 (blinking) -->
                        <TextBlock Text=":"
                                   FontFamily="Consolas, 'Courier New', monospace"
                                   FontSize="76"
                                   FontWeight="Bold"
                                   Foreground="#00F0FF"
                                   Margin="2,-6,2,0"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Opacity" Value="1.0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ColonVisible}" Value="False">
                                            <Setter Property="Opacity" Value="0.2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Seconds -->
                        <TextBlock Text="{Binding Seconds}"
                                   FontFamily="Consolas, 'Courier New', monospace"
                                   FontSize="70"
                                   FontWeight="Bold"
                                   Foreground="#38BDF8"
                                   Margin="0,5,0,0"
                                   VerticalAlignment="Center"/>

                        <!-- AM / PM Indicator -->
                        <Border Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="14,6,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowAmPm, Converter={StaticResource BoolToVisConv}}">
                            <TextBlock Text="{Binding AmPm}"
                                       FontFamily="Consolas, monospace"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#F59E0B"/>
                        </Border>
                    </StackPanel>
                </Viewbox>

                <!-- Date & Summary Subtitle -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DateString}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="0" Text="{Binding StorageError}" Foreground="#FCA5A5"
                   TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,32,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                <DataTrigger Binding="{Binding StorageError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <!-- ================= 2. DAILY REMINDER NOTIFICATION BANNER ================= -->
        <Border Grid.Row="2"
                Background="#3B1804"
                BorderBrush="#F59E0B"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,12"
                Effect="{StaticResource ReminderGlow}"
                Visibility="{Binding HasReminderAlert, Converter={StaticResource BoolToVisConv}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReminderAlertTitle}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#FBBF24"/>
                    <TextBlock Text="{Binding ReminderAlertDetails}"
                               FontSize="12"
                               Foreground="#FED7AA"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding TestReminderChimeCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Padding="10,4" Margin="0,0,8,0"
                            ToolTip="Play reminder chime">
                        <TextBlock Text="🔔 Replay Chime"/>
                    </Button>
                    <Button Command="{Binding DismissReminderAlertCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Background="#78350F"
                            BorderBrush="#F59E0B"
                            Padding="12,4"
                            Content="Dismiss"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 3. NAVIGATION TABS & CONTENT ================= -->
        <Border Grid.Row="3"
                Background="#111827"
                BorderBrush="#1F2937"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Tab Buttons -->
                    <RowDefinition Height="Auto" />
                    <!-- Tab Page Content -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Navigation Tabs Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Tab 0: Alarm Settings -->
                    <Button Grid.Column="0"
                            Command="{Binding SwitchTabCommand}" CommandParameter="0"
                            Padding="18,8" Margin="0,0,8,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="0">
                                        <Setter Property="Background" Value="#0284C7" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#38BDF8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏰ " FontSize="14"/>
                            <TextBlock Text="Alarm Configuration" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Tab 1: Tasks & Reminders -->
                    <Button Grid.Column="1"
                            Command="{Binding SwitchTabCommand}" CommandParameter="1"
                            Padding="18,8"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                <Setter Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMainTab}" Value="1">
                                        <Setter Property="Background" Value="#0284C7" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#38BDF8" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="14"/>
                            <TextBlock Text="Tasks &amp; Reminders" FontWeight="Bold" Margin="0,0,8,0"/>
                            <!-- Active reminders badge -->
                            <Border Background="#F59E0B"
                                    CornerRadius="10"
                                    Padding="6,1"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔔 " FontSize="9" Foreground="#000000" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ActiveRemindersCount}"
                                               FontSize="11"
                                               FontWeight="ExtraBold"
                                               Foreground="#000000"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- TAB 0 CONTENT: ALARM CONFIGURATION -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMainTab}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Status & Countdown Banner -->
                        <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,10" CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Setter Property="BorderBrush" Value="#334155" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAlarmArmed}" Value="True">
                                            <Setter Property="Background" Value="#064E3B" />
                                            <Setter Property="BorderBrush" Value="#10B981" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="🔔 ALARM STATUS: " FontWeight="Bold" FontSize="13" Foreground="#CBD5E1"/>
                                        <TextBlock Text="{Binding AlarmStatusText}" FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#94A3B8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlarmArmed}" Value="True">
                                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding AlarmLabel}" FontSize="12" Foreground="#94A3B8" FontStyle="Italic"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="COUNTDOWN: " FontSize="11" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="{Binding CountdownText}" FontFamily="Consolas, monospace" FontSize="16" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAlarmArmed}" Value="True">
                                                            <Setter Property="Foreground" Value="#34D399" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Controls -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Time Pickers -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Hours -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="HOUR" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableHours}"
                                                  SelectedItem="{Binding SelectedHour, Mode=TwoWay}"
                                                  ItemStringFormat="{}{0:D2}" Width="80"/>
                                    </StackPanel>

                                    <!-- Minutes -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="MINUTE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableMinutes}"
                                                  SelectedItem="{Binding SelectedMinute, Mode=TwoWay}"
                                                  ItemStringFormat="{}{0:D2}" Width="80"/>
                                    </StackPanel>

                                    <!-- Seconds -->
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="SECOND" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableSeconds}"
                                                  SelectedItem="{Binding SelectedSecond, Mode=TwoWay}"
                                                  ItemStringFormat="{}{0:D2}" Width="80"/>
                                    </StackPanel>

                                    <!-- AM / PM -->
                                    <StackPanel Grid.Column="3" Margin="0,0,10,0"
                                                Visibility="{Binding ShowAmPm, Converter={StaticResource BoolToVisConv}}">
                                        <TextBlock Text="AM / PM" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableAmPm}"
                                                  SelectedItem="{Binding SelectedAmPm, Mode=TwoWay}" Width="80"/>
                                    </StackPanel>

                                    <!-- Beep Sound selection -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="ALARM BEEP TONE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding SoundTypes}"
                                                      SelectedItem="{Binding SelectedSound, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource SoundDescConv}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1"
                                                    Command="{Binding TestBeepCommand}"
                                                    Style="{StaticResource ModernButtonStyle}"
                                                    Margin="8,0,0,0" Height="34">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔊 "/>
                                                    <TextBlock Text="Test Beep"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Alarm Label -->
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="ALARM LABEL / NOTE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding AlarmLabel, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                                </StackPanel>

                                <!-- Presets -->
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="QUICK TIMER PRESETS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Button Command="{Binding SetPresetCommand}" CommandParameter="1" Style="{StaticResource PresetButtonStyle}" Content="⏱ +1 Min" Margin="0,0,8,6" />
                                        <Button Command="{Binding SetPresetCommand}" CommandParameter="5" Style="{StaticResource PresetButtonStyle}" Content="⏱ +5 Mins" Margin="0,0,8,6" />
                                        <Button Command="{Binding SetPresetCommand}" CommandParameter="10" Style="{StaticResource PresetButtonStyle}" Content="⏱ +10 Mins" Margin="0,0,8,6" />
                                        <Button Command="{Binding SetPresetCommand}" CommandParameter="15" Style="{StaticResource PresetButtonStyle}" Content="⏱ +15 Mins" Margin="0,0,8,6" />
                                        <Button Command="{Binding SetPresetCommand}" CommandParameter="30" Style="{StaticResource PresetButtonStyle}" Content="⏱ +30 Mins" Margin="0,0,8,6" />
                                        <Button Command="{Binding SetPresetCommand}" CommandParameter="60" Style="{StaticResource PresetButtonStyle}" Content="⏱ +1 Hour" Margin="0,0,8,6" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Primary Arm / Disarm Button -->
                        <Button Grid.Row="2"
                                Command="{Binding ToggleAlarmArmCommand}"
                                Content="{Binding ArmButtonText}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Height="44" Margin="0,10,0,0"/>
                    </Grid>
                </Grid>

                <!-- TAB 1 CONTENT: TASKS, PRIORITIES, DEADLINES & 7-DAY REMINDERS -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMainTab}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Add Task Card -->
                            <RowDefinition Height="Auto" />
                            <!-- Filter & Stats Bar -->
                            <RowDefinition Height="Auto" />
                            <!-- Task List -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Add Task Card -->
                        <Border Grid.Row="0"
                                Background="#1E293B"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Title, Priority, Deadline Row -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Task Title -->
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="NEW TASK TITLE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                                    </StackPanel>

                                    <!-- Priority Picker -->
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="PRIORITY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailablePriorities}"
                                                  SelectedItem="{Binding NewTaskPriority, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- Deadline Date -->
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="DEADLINE DATE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <DatePicker SelectedDate="{Binding NewTaskDueDate, Mode=TwoWay}"/>
                                    </StackPanel>

                                    <!-- Deadline Time Pickers -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,10,0">
                                        <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="TIME" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding TaskHours}"
                                                      SelectedItem="{Binding NewTaskDueHour, Mode=TwoWay}"
                                                      Width="60"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,4,0">
                                              <TextBlock Text="MIN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                              <ComboBox ItemsSource="{Binding AvailableMinutes}" SelectedItem="{Binding NewTaskDueMinute, Mode=TwoWay}" Width="55" ItemStringFormat="{}{0:D2}"/>
                                          </StackPanel>
                                          <StackPanel Margin="0,0,4,0">
                                            <TextBlock Text="AM/PM" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AvailableAmPm}"
                                                      SelectedItem="{Binding NewTaskDueAmPm, Mode=TwoWay}"
                                                      Width="66"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Add Button -->
                                    <Button Grid.Column="4"
                                            Command="{Binding AddTaskCommand}"
                                            Content="➕ Add Task"
                                            Background="#0284C7"
                                            Foreground="#FFFFFF"
                                            FontWeight="Bold"
                                            Padding="14,0"
                                            Height="34"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource ModernButtonStyle}"/>
                                </Grid>

                                <!-- Task Description Note -->
                                <Grid Grid.Row="1">
                                    <StackPanel>
                                        <TextBlock Text="TASK DESCRIPTION / NOTES (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding NewTaskDescription, UpdateSourceTrigger=PropertyChanged}" Height="30" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Filter and Summary Bar -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Filter:" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <Button Command="{Binding SetTaskFilterCommand}" CommandParameter="All"
                                        Style="{StaticResource ModernButtonStyle}" Padding="10,4" Margin="0,0,6,0" Content="All Tasks"/>
                                <Button Command="{Binding SetTaskFilterCommand}" CommandParameter="Active"
                                        Style="{StaticResource ModernButtonStyle}" Padding="10,4" Margin="0,0,6,0" Content="Active"/>
                                <Button Command="{Binding SetTaskFilterCommand}" CommandParameter="Reminders"
                                        Style="{StaticResource ModernButtonStyle}" Padding="10,4" Margin="0,0,6,0"
                                        Foreground="#F59E0B" BorderBrush="#F59E0B">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔔 7-Day Reminders"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SetTaskFilterCommand}" CommandParameter="Completed"
                                        Style="{StaticResource ModernButtonStyle}" Padding="10,4" Content="Completed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="ℹ️ Reminders sound daily when a deadline is within 7 days"
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="#94A3B8"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tasks Items List -->
                        <ListBox Grid.Row="2"
                                 ItemsSource="{Binding FilteredTasks}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#334155" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReminderActive}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#F59E0B" />
                                                        <Setter Property="Background" Value="#221C16" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                        <Setter Property="BorderBrush" Value="#EF4444" />
                                                        <Setter Property="Background" Value="#261418" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Complete Checkbox -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Main Task Details -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Status Badge & Action -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Complete Checkbox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      Command="{Binding DataContext.ToggleTaskCompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"/>

                                            <!-- Task Details -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <!-- Priority Badge -->
                                                    <Border Background="{Binding Priority, Converter={StaticResource PriorityColorConv}}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Priority}"
                                                                   FontSize="10"
                                                                   FontWeight="ExtraBold"
                                                                   Foreground="#FFFFFF"/>
                                                    </Border>

                                                    <!-- Title -->
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="#F8FAFC"
                                                               TextDecorations="{Binding IsCompleted, Converter={StaticResource StrikeConv}}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Description}"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,4"/>

                                                <!-- Deadline Date info -->
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⏰ Deadline: " FontSize="11" Foreground="#64748B"/>
                                                    <TextBlock Text="{Binding Deadline, StringFormat='{}{0:f}'}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="#94A3B8"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status & Delete -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Status pill badge -->
                                                <Border CornerRadius="6"
                                                        Padding="8,4"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#0F172A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsReminderActive}" Value="True">
                                                                    <Setter Property="Background" Value="#451A03" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                    <Setter Property="Background" Value="#450A0A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="{Binding StatusSummary}"
                                                               FontSize="12"
                                                               FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#38BDF8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsReminderActive}" Value="True">
                                                                        <Setter Property="Foreground" Value="#FBBF24" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Foreground" Value="#F87171" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Foreground" Value="#10B981" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Delete button -->
                                                <Button Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ModernButtonStyle}"
                                                        Padding="8,4"
                                                        Background="#450A0A"
                                                        BorderBrush="#DC2626"
                                                        ToolTip="Delete Task">
                                                    <TextBlock Text="🗑" FontSize="12" Foreground="#EF4444"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ================= 4. RINGING ALARM MODAL OVERLAY ================= -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#EE0F172A"
                CornerRadius="14"
                Visibility="{Binding IsAlarmRinging, Converter={StaticResource BoolToVisConv}}"
                Panel.ZIndex="100">
            <Border Background="#1E293B"
                    BorderBrush="#EF4444"
                    BorderThickness="2"
                    CornerRadius="16"
                    Padding="36"
                    MaxWidth="520"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Effect="{StaticResource AlarmPulseGlow}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⏰" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="ALARM RINGING!"
                               FontSize="28"
                               FontWeight="ExtraBold"
                               Foreground="#EF4444"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding AlarmLabel}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="Beeping in progress..."
                               FontSize="13"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Dismiss Button -->
                        <Button Command="{Binding DismissAlarmCommand}"
                                Content="🛑 STOP ALARM"
                                Background="#EF4444"
                                Foreground="#FFFFFF"
                                FontSize="15"
                                FontWeight="Bold"
                                Padding="20,12"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,14,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Snooze Button -->
                        <Button Command="{Binding SnoozeAlarmCommand}"
                                Content="💤 SNOOZE (5 MIN)"
                                Background="#F59E0B"
                                Foreground="#FFFFFF"
                                FontSize="15"
                                FontWeight="Bold"
                                Padding="20,12"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
